 <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>



<style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        color: gray;
 
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Oxygen,
          Ubuntu,
          Cantarell,
          "Open Sans",
          "Helvetica Neue",
          sans-serif;
      }

      body {
        /* display: flex;
        justify-content: center;
        align-items: center; */
        min-height: 90vh;
        background-color: rgb(37, 34, 34);
      }

    .profileBox{
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 30px 20px;
        flex-direction: column;
    }

    
    #formBox{
        display: flex;
        width: 100%;
        justify-content: center;
        align-items: center;
        flex-direction: column;
        gap: 10px;

    }
    form textarea{
        width: 340px;
        resize: none;
        height: 100px;
     border: 2px solid rgb(114, 111, 111);
         background-color: rgb(37, 34, 34);
         padding: 10px 10px;
         font-size: 20px;
    }

    form button{
     border: 2px solid rgb(114, 111, 111);
         background-color: rgb(37, 34, 34);
         padding: 10px 30px;
         font-size: 20px;
         cursor: pointer;
         border-radius: 60px;

    }

 
    .nav{
        display: flex;
        padding: 20px ;
        justify-content: space-evenly;
        align-items: center;
    }
    .nav a{

    color: rgb(0, 247, 255);
        text-decoration: none;

    }

 
 
 
      </style>
<body>




    <!-- nav bar section  -->

    <div class="nav">

        <a href="/profile" id="home">Home</a>
        <a href="/logout"id="logout">Log OUt</a>
    </div>
        
    <div class="profileBox">



       
            
            <h1>Hello ! <%=user.username%></h1>
            
            
        </div>
        
        
        
        

    


    <form action="/updatePost/<%=post._id%>", method="post" id="formBox">
              
        <textarea name="content" > <%=post.content%></textarea>
        
        <button type="submit">Post</button>
        


    </form>


 
    
    
 


    </div>



</body>
</html>