<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        color: rgb(252, 247, 247);
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Oxygen,
          Ubuntu,
          Cantarell,
          "Open Sans",
          "Helvetica Neue",
          sans-serif;
      }

      body {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        background-color: rgb(37, 34, 34);
      }

      .container {
        display: flex;
        background-color: rgb(37, 34, 34);
        flex-direction: column;
        align-items: center;
        justify-content: center;

        height: 100%;
        width: 100%;
        gap: 30px;
      }

      .formSection {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        height: 100%;
        width: 100%;

        gap: 9px;
      }

      .formSection input,
      button {
        width: 90%;
        padding: 15px 10px;
        font-size: 18px;
        border: 1px solid rgb(165, 165, 165);
        border-radius: 10px;
        background-color: rgb(37, 34, 34);
      }

      #btn {
        border-radius: 60px;
        border: 0px;
        background-color: rgb(3, 0, 204);
        color: white;
        cursor: pointer;
      }

      #btn2 {
        width: 90%;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 2px solid rgb(3, 0, 204);
        border-radius: 60px;
        padding: 10px;
        cursor: pointer;
      }

      #btn2 a {
        text-decoration: none;
        color: rgb(95, 162, 250);
        font-size: 20px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <img src="person.png" width="70px" height="70" />

      <form action="/register" method="post" class="formSection" id="form">
        <input
          type="text"
          placeholder="Enter your Name"
          name="name"
          id="name"
        />
        <p id="nameMsg"></p>
        <input
          type="text"
          placeholder="Enter your username"
          name="username"
          id="username"
        />
        <p id="usernameMsg"></p>

        <input
          type="email"
          placeholder="Enter your email"
          name="email"
          id="email"
        />

        <input
          type="text"
          placeholder="Enter your password"
          name="password"
          id="password"
        />
        <p id="passwordMsg"></p>
        <input type="number" placeholder="Enter your age" name="age" id="age" />
        <p id="ageMsg"></p>

        <button type="submit" id="btn">Register Account</button>
        <p id="finalMsg"></p>
      </form>

      <div id="btn2">
        <a href="/">Login here</a>
      </div>

      <script>
        let user_username = document.getElementById("username");
        let user_email = document.getElementById("email");

        let form = document.getElementById("form");

        let checker = false;

        // checking if username is already available or not
        user_username.addEventListener("blur", async () => {
          let res = await fetch("/check_username", {
            method: "post",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ username: user_username.value }),
          });

          let data = await res.json();

          if (data.taken) {
            document.getElementById("usernameMsg").innerHTML =
              "this username already taken";
            checker = true;
          } else {
            checker = false;
            document.getElementById("usernameMsg").innerText = "";
          }
        });
 
 
        // checking all the validation before submiting our form
        form.addEventListener("submit", (e) => {
          // console.log(checker);

          let username = document.getElementById("username");
          let password = document.getElementById("password");
          let email = document.getElementById("email");
          let name = document.getElementById("name");
          let age = document.getElementById("age");

          if (
            username.value == "" ||
            email.value == "" ||
            password.value == "" ||
            age.value == "" ||
            name.value == ""
          ) {
            document.getElementById("finalMsg").innerHTML =
              "kindly fill all the value";
            checker = true;
          } else if (username.value.length < 4) {
            document.getElementById("usernameMsg").innerHTML =
              "length should be greater than 4";
            checker = true;
          } else if (password.value.length < 6) {
            document.getElementById("passwordMsg").innerHTML =
              "password length should be greater than 6";
            checker = true;
          } else if (age.value < 10 || age.value > 100) {
            document.getElementById("ageMsg").innerHTML =
              "kindly enter valid age btw 10 to 100";
            checker = true;
          } else {
            checker = false;
          }

          if (checker) {
            e.preventDefault();
          }
          
          else{

            
            setTimeout(() => {
              console.log('hello')
              username.value = "";
              email.value = "";
              password.value = "";
              age.value = "";
              
              name.value = "";
            }, 100);
            
          }


        });
      </script>
    </div>
  </body>
</html>
