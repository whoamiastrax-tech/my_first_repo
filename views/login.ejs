<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        color: rgb(252, 247, 247);
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Oxygen,
          Ubuntu,
          Cantarell,
          "Open Sans",
          "Helvetica Neue",
          sans-serif;
      }

      body {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh;
        background-color: rgb(37, 34, 34);
      }

      .container {
        display: flex;
        background-color: rgb(37, 34, 34);
        flex-direction: column;
        align-items: center;
        justify-content: center;

        height: 100%;
        width: 100%;
        gap: 90px;
      }

      .formSection {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;

        height: 100%;
        width: 100%;

        gap: 12px;
      }

      .formSection input,
      button {
        width: 90%;
        padding: 15px 10px;
        font-size: 18px;
        border: 1px solid rgb(165, 165, 165);
        border-radius: 10px;
        background-color: rgb(37, 34, 34);
      }

      #btn {
        border-radius: 60px;
        border: 0px;
        background-color: rgb(3, 0, 204);
        color: white;
        cursor: pointer;
      }

      #btn2 {
        width: 90%;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 2px solid rgb(3, 0, 204);
        border-radius: 60px;
        padding: 10px;
        cursor: pointer;
      }

      #btn2 a {
        text-decoration: none;
        color: rgb(95, 162, 250);
        font-size: 20px;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <img src="person.png" width="70px" height="70" />
      <!-- <input type="text" placeholder="Enter your Name" name="name">
        <input type="text" placeholder="Enter your username" name="username"> -->
      <form action="/login" method="post" class="formSection">
        <input
          type="email"
          placeholder="Enter your email"
          name="email"
          id="email"
        />
        <input
          type="text"
          placeholder="Enter your password"
          name="password"
          id="password"
        />
        <p id="passwordMsg"></p>
        <button type="submit" id="btn">Log in</button>
      </form>

      <div id="btn2">
        <a href="/register">Create new account</a>
      </div>
    </div>

    <script> 
   
           

       
   let form= document.querySelector(".formSection")
   form.addEventListener("submit", ()=>{
   
    setTimeout(() => {
       
      document.getElementById("email").value="";
      document.getElementById("password").value=""
    }, 1000);


   })

  
 
      
    </script>
  </body>
</html>
