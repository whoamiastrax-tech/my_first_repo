<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>



<style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        color: gray;
 
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          Roboto,
          Oxygen,
          Ubuntu,
          Cantarell,
          "Open Sans",
          "Helvetica Neue",
          sans-serif;
      }

      body {
        /* display: flex;
        justify-content: center;
        align-items: center; */
        min-height: 90vh;
        background-color: rgb(37, 34, 34);
      }

    
    #logout{
        align-self: flex-end;
        color: rgb(0, 247, 255);
        text-decoration: none;
    }
 


    .container{

        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        flex-direction: column;
        gap:10px;
        padding: 20px 0px;


    }

    

    .contentBox{
        
     border: 2px solid rgb(114, 111, 111);
     border-radius: 30px;
     
        width: 350px;
        height: 100px;
 
        display: grid;
        grid-template-columns: 2fr 1fr ;
         

    }
 
 
    a{
           color: rgb(0, 247, 255);
        text-decoration: none;
    }
 
 #image{
         
    width: 60px;
    height: 60px;
    border-radius: 50%;

 }
 

 .nameClass{
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 10px 20px;
 }

  .imgClass{
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
 
    padding: 10px 20px;
 }

    
 
 
            
          
        
         .nav{
        display: flex;
        padding: 20px ;
        justify-content: space-evenly;
        align-items: center;
    }
    .nav a{

    color: rgb(0, 247, 255);
        text-decoration: none;

    }

 
 
 
      </style>
<body>




    <!-- nav bar section  -->

    <div class="nav">

        <a href="/profile" id="home">Home</a>
        <a href="/logout"id="logout">Log OUt</a>
    </div>
        
        

    


    
        


 


<div class="container">


 
    
    
    <% allUser.forEach((user)=>{ %>

     
       <% if(user.username === loggedInUser.username) { 
                     return;

       } %>
    

         <div class="contentBox">

             <div class="nameClass">

                 <h2><%=user.username%></h2>
                 <a href="/feed/<%=user._id%>">See Profile</a>
                </div>

                <div class="imgClass">

                    <img src="<%=user.pic%>" id="image">
                </div>
 

 

               
       
    </div>





       <%    }) %>




    </div>



</body>
</html>