            //         let res= await fetch(`/msgsection/${receiverid}`)
            //         console.log(res.url);
                   
            //         window.location.href=res.url;


            //     }
            //     fun();

            // }, 4000);


  window.onload = ()=>{
     
    window.scrollTo(0, document.body.scrollHeight);
  }


    </script>
</body>

</html>